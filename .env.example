# Copy to .env and fill values. Never commit .env.

# --- 로컬 ---
HELM_DATA_DIR=data
HELM_HOST=127.0.0.1
HELM_PORT=8080
HELM_PUBLIC_URL=http://127.0.0.1:8080
HELM_ADMIN_EMAILS=you@gmail.com
# openssl rand -base64 32 후 Fernet 키: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HELM_MASTER_KEY=
HELM_AUTH_DEV=false
HELM_RATE_LIMIT=true
HELM_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- OAuth (콘솔에 HELM_PUBLIC_URL/api/auth/{google|kakao|naver}/callback 등록) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Redis (선택) ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- 서버 기본 Binance는 쓰지 않음. 각 사용자가 대시보드에서 자기 키를 넣음 ---
BINANCE_ENVIRONMENT=demo

# --- 관리자 텔레그램 봇 (선택) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
